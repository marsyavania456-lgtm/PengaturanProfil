<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutUtama"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/latar_halaman"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- ===== header hijau ===== -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/hijau_header"
        android:gravity="center"
        android:text="@string/app_name"
        android:textColor="@color/hijau_teks_gelap"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- ===== kartu profil ===== -->
            <ImageView
                android:id="@+id/ivAvatar"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center_horizontal"
                android:layout_margin="8dp"
                android:background="@drawable/bg_avatar_besar"
                android:contentDescription="@string/desc_avatar"
                android:elevation="6dp"
                android:src="@drawable/avatar_1" />

            <TextView
                android:id="@+id/tvNamaKartu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/nama_default"
                android:textColor="#1B2430"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvEmailKartu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="@string/email_default"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvKotaKartu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/kota_default"
                android:textColor="#64748B"
                android:textSize="14sp" />

            <!-- garis pemisah -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="14dp"
                android:background="@color/garis_input" />

            <!-- ===== pilihan avatar ===== -->
            <TextView
                android:id="@+id/tvLabelAvatar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/label_pilih_avatar"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/ivPilih1"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="6dp"
                    android:contentDescription="@string/desc_avatar"
                    android:padding="4dp"
                    android:src="@drawable/avatar_1" />

                <ImageView
                    android:id="@+id/ivPilih2"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="6dp"
                    android:contentDescription="@string/desc_avatar"
                    android:padding="4dp"
                    android:src="@drawable/avatar_2" />

                <ImageView
                    android:id="@+id/ivPilih3"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_margin="6dp"
                    android:contentDescription="@string/desc_avatar"
                    android:padding="4dp"
                    android:src="@drawable/avatar_3" />
            </LinearLayout>

            <!-- ===== form isian ===== -->
            <EditText
                android:id="@+id/etNama"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:hint="@string/label_nama"
                android:inputType="textPersonName"
                android:padding="14dp"
                android:textColor="#1B2430" />

            <EditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:hint="@string/label_email"
                android:inputType="textEmailAddress"
                android:padding="14dp"
                android:textColor="#1B2430" />

            <EditText
                android:id="@+id/etKota"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:hint="@string/label_kota"
                android:inputType="textCapWords"
                android:padding="14dp"
                android:textColor="#1B2430" />

            <EditText
                android:id="@+id/etBio"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:hint="@string/label_bio"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:padding="14dp"
                android:textColor="#1B2430" />

            <!-- ===== sakelar mode gelap ===== -->
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/swGelap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/label_mode_gelap"
                android:textColor="#1B2430" />

            <!-- ===== tombol aksi ===== -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="@string/btn_simpan"
                android:textColor="#14301F"
                android:textStyle="bold"
                app:backgroundTint="@color/hijau_tombol"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:stateListAnimator="@null"
                android:text="@string/btn_reset"
                android:textColor="#64748B"
                android:textStyle="bold"
                app:backgroundTint="@android:color/transparent"
                app:cornerRadius="14dp"
                app:strokeColor="@color/garis_input"
                app:strokeWidth="1dp" />

            <!-- garis pemisah -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="14dp"
                android:background="@color/garis_input" />

            <!-- ===== LATIHAN 1: nama panggilan ===== -->
            <TextView
                android:id="@+id/tvJudulLatihan1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/judul_latihan1"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSapaan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/sapaan_kosong"
                android:textColor="#1B2430"
                android:textSize="18sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etPanggilan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_input"
                android:gravity="center"
                android:hint="@string/hint_panggilan"
                android:inputType="textPersonName"
                android:padding="14dp"
                android:textColor="#1B2430" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSimpanPanggilan"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="10dp"
                android:text="@string/btn_simpan_panggilan"
                android:textColor="#14301F"
                android:textStyle="bold"
                app:backgroundTint="@color/hijau_tombol"
                app:cornerRadius="14dp" />

            <!-- ===== LATIHAN 3: penghitung pembukaan ===== -->
            <TextView
                android:id="@+id/tvJumlah"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:textColor="#64748B"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>